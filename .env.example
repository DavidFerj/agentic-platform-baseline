# Copy to .env for local development. Values below are non-production placeholders.
PLATFORM_ENVIRONMENT=development
PLATFORM_LOG_LEVEL=INFO
PLATFORM_AUTH_MODE=development
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform_runtime:replace-with-runtime-password@postgres:5432/platform
PLATFORM_CORS_ORIGINS=http://localhost:3000
PLATFORM_API_BASE_URL=http://api:8000
NEXT_PUBLIC_PLATFORM_API_BASE_URL=http://localhost:8000

# Firebase Local Emulator Suite. Production uses App Hosting-provided configuration
# and Application Default Credentials; never commit service-account keys.
PLATFORM_FIREBASE_PROJECT_ID=agentic-platform-local
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agentic-platform-local
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_API_KEY=local-emulator-only
NEXT_PUBLIC_FIREBASE_APP_ID=local-emulator-only
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

POSTGRES_DB=platform
POSTGRES_USER=platform_owner
POSTGRES_PASSWORD=replace-with-owner-password
POSTGRES_APP_USER=platform_runtime
POSTGRES_APP_PASSWORD=replace-with-runtime-password

REDIS_PASSWORD=replace-with-local-password

MINIO_ROOT_USER=agentic-platform-local
MINIO_ROOT_PASSWORD=replace-with-local-password
