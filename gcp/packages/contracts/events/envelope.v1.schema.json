{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.agentic-platform.local/events/envelope.v1.schema.json",
  "title": "Agentic Platform event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "tenant_id",
    "correlation_id",
    "producer",
    "schema_version",
    "idempotency_key",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[\\da-f]{2}-[\\da-f]{32}-[\\da-f]{16}-[\\da-f]{2}$"
    },
    "data": {
      "type": "object"
    }
  }
}
