{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-platform-baseline:compliance:policy-decision:v1",
  "title": "Data protection policy decision evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "actor_id",
    "resource_type",
    "resource_id",
    "action",
    "purpose",
    "effect",
    "reasons",
    "obligations",
    "policy_id",
    "policy_version",
    "evidence_fingerprint"
  ],
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "actor_id": { "type": "string", "format": "uuid" },
    "resource_type": { "type": "string", "minLength": 1, "maxLength": 100 },
    "resource_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "action": { "type": "string", "minLength": 1, "maxLength": 100 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 100 },
    "effect": { "enum": ["permit", "deny", "require_approval"] },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "policy_matched",
          "approval_required",
          "action_not_allowed",
          "purpose_not_allowed",
          "role_not_allowed",
          "authority_not_allowed",
          "consent_evidence_required",
          "provider_not_allowed",
          "region_not_allowed",
          "classification_not_allowed"
        ]
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audit_decision",
          "enforce_retention",
          "minimize_data",
          "redact_direct_identifiers",
          "human_approval"
        ]
      }
    },
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "policy_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "evidence_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
